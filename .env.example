# Base del backend Laravel. El cliente Axios le agrega /api/v1 automáticamente.
# El backend (bar-pos-saas-api) corre con Docker y queda expuesto en el host en el
# puerto 8080 (APP_FORWARD_PORT). Si lo corrieras sin Docker con `php artisan serve`,
# el puerto por defecto sería 8000; ajusta segun como lo levantes.
VITE_API_URL=http://localhost:8080
